# Terraform generated files
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
.terraform.lock.hcl

# Secrets and sensitive files
*.tfvars
*.tfvars.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: Ignore override files as they are usually used for local testing
# and not checked into version control.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Optional: ignore plan output files generated by `terraform plan -out=tfplan`
# example: *tfplan*

# Optional: ignore graph output files
*.svg
*.png

# Crash log files
crash.log
crash.*.log